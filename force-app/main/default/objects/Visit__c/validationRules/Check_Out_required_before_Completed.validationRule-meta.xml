<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Check_Out_required_before_Completed</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status__c,&quot;Completed&quot;),
    ISBLANK(Check_Out_Time__c)
)</errorConditionFormula>
    <errorMessage>Check Out Time is required before completing the visit.</errorMessage>
</ValidationRule>
